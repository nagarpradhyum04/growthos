# ---- Core ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/growthos
JWT_SECRET=change-me-to-a-long-random-string
# Base URL of the backend (used to build unsubscribe links in emails)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---- LLM ----
# openai | gemini | mock   (mock is a deterministic offline adapter for local development)
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60

# ---- Email ----
# smtp | resend | mock   (mock only records emails; nothing is actually sent)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# smtp: e.g. Gmail — SMTP_PASSWORD must be a Google "App password" (Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: read prospects' replies from the same mailbox (Gmail: enable IMAP). Uses the SMTP login by default.
IMAP_HOST=
IMAP_PORT=993

# ---- Web research ----
# tavily | none   (website fetching of the lead's own site always runs)
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ---- Business rules ----
MAX_FOLLOWUPS=2
FOLLOWUP_DELAY_DAYS=3
QUALIFICATION_THRESHOLD=60

# ---- Webhooks ----
# Required in the X-Webhook-Secret header for /webhooks/* (inbound replies, delivery events)
WEBHOOK_SECRET=

# ---- Customer portal (separate app on its own port) ----
PORTAL_URL=http://localhost:5174

# ---- Social media posts (weekly 1 static + 1 video) ----
# gemini = Nano Banana (gemini-2.5-flash-image) for images + Veo for video; mock = offline previews
MEDIA_PROVIDER=mock
GEMINI_API_KEY=
# auto = Google AI Studio, falling back to Vertex AI if the key is rejected there ("AQ." keys come from both).
GEMINI_BACKEND=auto
# Leave LLM_MODEL empty with LLM_PROVIDER=gemini to use gemini-flash-latest. If a configured Gemini model is
# retired (HTTP 404), GrowthOS switches to the best model your key can use and logs which one.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
SOCIAL_IMAGE_ASPECT=1:1
SOCIAL_VIDEO_ASPECT=9:16
# The worker drafts one image + one video post per business each week (they still need your approval).
SOCIAL_AUTO_WEEKLY=true
