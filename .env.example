# ---- Core ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/growthos
JWT_SECRET=change-me-to-a-long-random-string
# Base URL of the backend (used to build unsubscribe links in emails)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---- LLM ----
# openai | mock   (mock is a deterministic offline adapter for local development)
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60

# ---- Email ----
# resend | mock   (mock only logs emails; nothing is actually sent)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ---- Web research ----
# tavily | none   (website fetching of the lead's own site always runs)
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ---- Business rules ----
MAX_FOLLOWUPS=2
FOLLOWUP_DELAY_DAYS=3
QUALIFICATION_THRESHOLD=60

# ---- Webhooks ----
# Required in the X-Webhook-Secret header for /webhooks/* (inbound replies, delivery events)
WEBHOOK_SECRET=
